{
  "name": "@ihxy/orcha-materials",
  "type": "module",
  "version": "0.2.2",
  "description": "Orcha — built-in start / end / task / condition nodes.",
  "license": "Apache-2.0",
  "homepage": "https://crayon-hua.github.io/orcha/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crayon-hua/orcha.git",
    "directory": "packages/materials"
  },
  "bugs": {
    "url": "https://github.com/Crayon-hua/orcha/issues"
  },
  "keywords": [
    "orcha",
    "vue",
    "workflow",
    "nodes",
    "materials",
    "orchestration"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/builtin.ts",
    "./src/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm type-check && pnpm build",
    "publish:only": "pnpm publish --access public --no-git-checks --no-provenance --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@ihxy/orcha-core": "workspace:*",
    "@ihxy/orcha-vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^3.2.7",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  }
}
