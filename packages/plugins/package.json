{
  "name": "@ihxy/orcha-plugins",
  "type": "module",
  "version": "0.2.6",
  "description": "Orcha — plugin lifecycle plus history, copy-paste, and keyboard shortcuts.",
  "license": "Apache-2.0",
  "homepage": "https://crayon-hua.github.io/orcha/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crayon-hua/orcha.git",
    "directory": "packages/plugins"
  },
  "bugs": {
    "url": "https://github.com/Crayon-hua/orcha/issues"
  },
  "keywords": [
    "orcha",
    "vue",
    "workflow",
    "plugin",
    "history",
    "orchestration"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm type-check && pnpm build",
    "publish:only": "pnpm publish --access public --no-git-checks --no-provenance --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@ihxy/orcha-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3",
    "vue": "^3.5.18"
  }
}
